package srcs.persistance;

import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.IOException;

public class PersistanceArray {

	public static void saveArrayInt(String f, int[] tab) throws IOException {
		try (FileOutputStream file = new FileOutputStream(f)) {
			int i = 0;
			for(i=0; i<tab.length; i++) {
				file.write(tab[i]);;
			}
			file.close();
		}
	}
	
	public static int[] loadArrayInt(String fichier) throws IOException {
		int[] tab= new int[6];
		int read, i=0;
		FileInputStream file= new FileInputStream(fichier);
		while((read=file.read())!=-1) {
			tab[i++] = read;
		}
		file.close();
		
		return tab;
	}
}
